import pandas as pd
import numpy as np

INPUT = "data/raw/CTB/ctb_fahrplan_lkw_0304.csv"
OUTPUT = "data/raw/CTB/transition_baseline.csv"

df = pd.read_csv(INPUT, sep=";")

transitions = []

for case_id, grp in df.groupby("FAHRPLAN_UID"):

    grp = grp.sort_values(
        "ANLAUFPUNKT_SEQUENZNUMMER"
    )

    # ----------------------------------
    # Gate In → First Stop
    # ----------------------------------

    first = grp.iloc[0]

    travel = first["FP_DAUER_GATEIN_ERSTER_ALP_SEK"]

    if pd.notna(travel) and travel > 0:

        transitions.append(
            (
                "Gate In",
                first["ANLAUFPUNKT_HALTESTELLE"],
                float(travel)
            )
        )

    # ----------------------------------
    # Stop → Next Stop
    # ----------------------------------

    for i in range(len(grp)-1):

        current = grp.iloc[i]
        nxt = grp.iloc[i+1]

        travel = current["ALP_DAUER_NAECHSTER_ALP_SEK"]

        if pd.notna(travel) and travel > 0:

            transitions.append(
                (
                    current["ANLAUFPUNKT_HALTESTELLE"],
                    nxt["ANLAUFPUNKT_HALTESTELLE"],
                    float(travel)
                )
            )

    # ----------------------------------
    # Last Stop → Gate Out
    # ----------------------------------

    last = grp.iloc[-1]

    travel = last["FP_DAUER_LETZT_ALP_GATEOUT_SEK"]

    if pd.notna(travel) and travel > 0:

        transitions.append(
            (
                last["ANLAUFPUNKT_HALTESTELLE"],
                "Gate Out",
                float(travel)
            )
        )

# --------------------------------------
# Build Transition Table
# --------------------------------------

trans_df = pd.DataFrame(
    transitions,
    columns=[
        "activity",
        "next_activity",
        "duration_sec"
    ]
)

rows = []

for (a, b), grp in trans_df.groupby(
    ["activity", "next_activity"]
):

    if len(grp) < 20:
        continue

    baseline = np.percentile(
        grp["duration_sec"],
        5
    )

    rows.append(
        {
            "activity": a,
            "next_activity": b,
            "baseline_duration_sec": round(
                baseline,
                1
            ),
            "samples": len(grp),
            "mean_duration_sec": round(
                grp["duration_sec"].mean(),
                1
            )
        }
    )

baseline_df = pd.DataFrame(rows)

baseline_df = baseline_df.sort_values(
    [
        "activity",
        "next_activity"
    ]
)

baseline_df.to_csv(
    OUTPUT,
    index=False
)

print(
    f"Saved {len(baseline_df)} transitions"
)

print(
    baseline_df.head(20)
)